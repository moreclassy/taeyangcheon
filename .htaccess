# HTTP -> HTTPS, www -> apex 리다이렉트 (한 번의 301 로 https://taeyang1000.com/... 으로 통일)
# 검색엔진이 www 와 apex 를 별개 사이트로 보지 않게 하기 위함. SSL Basic 인증서가 www 도 포함하므로 https://www 접속도 안전하게 넘어감
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://taeyang1000.com%{REQUEST_URI} [R=301,L]

# 카페24 기본 파일(내부 호스트명 노출) 차단. <Files>+Require 대신 mod_rewrite 를 써서 AllowOverride(AuthConfig) 제한과 무관하게 동작
RewriteRule ^hosting_index\.html$ - [F,L]

# 없는 주소는 한글 404 페이지로 (src/pages/404.html, 자산 경로가 / 로 시작해 어느 URL 에서도 깨지지 않음)
ErrorDocument 404 /404.html

# 폰트 MIME 타입. 서버가 woff2 를 Content-Type 없이, woff 를 application/x-font-woff 로 보내 아래 1년 캐시 규칙이 적용되지 않던 문제 (2026-09-26)
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType font/ttf .ttf
</IfModule>

# 브라우저 캐시 (정적 파일). css/js 는 HTML 에서 ?v= 버전 문자열로 갱신하므로 1년 + immutable (고치면 반드시 ?v= 올릴 것)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/gif "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType application/pdf "access plus 1 day"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js|woff2?|ttf)$">
    Header merge Cache-Control "immutable"
  </FilesMatch>
</IfModule>

# 보안 헤더. Referrer-Policy 는 admin/index.php 가 PHP 에서 직접 지정하므로 정적 파일에만 적용
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(html|css|js|jpe?g|png|gif|webp|svg|ico|xml|txt|woff2?|ttf|eot)$">
    Header set Referrer-Policy "strict-origin-when-cross-origin"
  </FilesMatch>
</IfModule>
